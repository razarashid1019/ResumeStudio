#!/bin/bash
# ResumeStudio launcher — starts the local server if needed, opens an app-mode window.
set -e

APP_HOME="/Users/razarashid/Desktop/College/Vibe Code Projects/ResumeStudio"
PORT=8765
URL="http://127.0.0.1:${PORT}"
PID_FILE="$APP_HOME/data/server.pid"
SERVER_LOG="$APP_HOME/data/server.log"
PYTHON_BIN="/Library/Frameworks/Python.framework/Versions/3.13/bin/python3"

is_server_up() {
  curl -s -o /dev/null -m 1 "$URL/api/applications"
}

# Rebuild the React frontend (frontend/, 2026-09-15 rewrite) if its source
# changed since the last build. web-dist/ is gitignored -- it's always a
# local build artifact, never committed -- so a fresh clone or pull needs
# this to produce anything at all, not just to pick up edits.
FRONTEND_DIR="$APP_HOME/frontend"
WEB_DIST="$APP_HOME/web-dist"
if [ -d "$FRONTEND_DIR" ]; then
  NEEDS_BUILD=0
  if [ ! -f "$WEB_DIST/index.html" ]; then
    NEEDS_BUILD=1
  elif [ -n "$(find "$FRONTEND_DIR/src" "$FRONTEND_DIR/vite.config.ts" -newer "$WEB_DIST/index.html" 2>/dev/null)" ]; then
    NEEDS_BUILD=1
  fi
  if [ "$NEEDS_BUILD" = "1" ]; then
    ( cd "$FRONTEND_DIR" && npm run build ) >> "$SERVER_LOG" 2>&1
  fi
fi

if ! is_server_up; then
  # stale pid file cleanup
  if [ -f "$PID_FILE" ]; then
    OLD_PID="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
      kill "$OLD_PID" 2>/dev/null || true
      sleep 0.3
    fi
    rm -f "$PID_FILE"
  fi
  nohup "$PYTHON_BIN" -u "$APP_HOME/server/app.py" >> "$SERVER_LOG" 2>&1 &
  disown

  for i in $(seq 1 30); do
    if is_server_up; then break; fi
    sleep 0.2
  done
fi

if [ -d "/Applications/Google Chrome.app" ]; then
  open -na "Google Chrome" --args --app="$URL"
else
  open "$URL"
fi
